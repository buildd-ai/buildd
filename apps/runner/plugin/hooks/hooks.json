{
  "description": "buildd presence: session start/touch/end and claim binding. Fails open; sends no content.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/buildd-hook.mjs\" claude", "timeout": 5, "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/buildd-hook.mjs\" claude", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/buildd-hook.mjs\" claude", "timeout": 5, "async": true }] }],
    "PostToolUse": [{ "matcher": "mcp__.*buildd.*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/buildd-hook.mjs\" claude", "timeout": 5, "async": true }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/buildd-hook.mjs\" claude", "timeout": 5 }] }]
  }
}
