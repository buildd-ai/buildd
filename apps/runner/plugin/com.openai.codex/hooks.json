{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/buildd-hook.mjs\" codex", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/buildd-hook.mjs\" codex", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/buildd-hook.mjs\" codex", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "mcp__.*buildd.*", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/buildd-hook.mjs\" codex", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/buildd-hook.mjs\" codex", "timeout": 5 }] }]
  }
}
