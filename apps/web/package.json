{
  "name": "@buildd/web",
  "version": "0.299.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun run db:migrate && bun run prompts:seed && next build",
    "build:only": "next build",
    "chat-eval": "bun --preload ../../scripts/stub-server-only.ts scripts/chat-eval/cli.ts",
    "db:migrate": "bun run ../../packages/core/db/migrate.ts",
    "prompts:seed": "bun --preload ../../scripts/stub-server-only.ts scripts/seed-prompts.ts",
    "prompts:export": "bun scripts/export-prompt-defaults.ts",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "doctor": "bun run scripts/doctor.ts",
    "doctor:vercel": "bun run scripts/doctor.ts --vercel",
    "reconcile:pr-state": "bun run scripts/reconcile-pr-merge-state.ts",
    "chat-retro:visible-fixture": "bun --preload ../../scripts/stub-server-only.ts scripts/chat-retro-visible-fixture.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/react": "^4.0.119",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@axiomhq/js": "^2.0.0",
    "@buildd/core": "workspace:*",
    "@buildd/dispatch-contract": "workspace:*",
    "@buildd/shared": "workspace:*",
    "@builddai/ai-kit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neondatabase/serverless": "^1.0.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@upstash/redis": "^1.36.2",
    "@vercel/otel": "^2.1.1",
    "ai": "^7.0.116",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.30",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "license": "FSL-1.1-ALv2"
}
