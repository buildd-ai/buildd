{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildd-cloud-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One container application backing the WorkerAgent Durable Object. The
  // image is the runner's --once image (apps/runner/Dockerfile.once), built
  // from the repo root because it needs the lockfile and workspace packages.
  // Paths are relative to this file.
  "containers": [
    {
      "class_name": "WorkerAgent",
      "image": "../runner/Dockerfile.once",
      "image_build_context": "../..",
      // 1/2 vCPU, 4 GiB, 8 GB disk. Enough for Claude Code plus a
      // depth-limited clone; revisit with canary numbers (design, open question 2).
      "instance_type": "standard-1",
      "max_instances": 10,
      // A deploy rolls the container application. With the default grace of
      // 0 s every running task container is shut down at once (SIGTERM, exit
      // 143), including a run the restarted agent has just resumed. 30 min
      // lets in-flight runs finish; a longer run is parked and resumed by the
      // restarted agent (Phase 2, resumable runs).
      "rollout_active_grace_period": 1800
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WorkerAgent", "class_name": "WorkerAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkerAgent"] }],

  // Warm-repo snapshots (docs/design/cloudflare-sandbox-runner.md, Phase 2).
  // Only the Worker reads or writes this bucket (src/snapshots.ts); the
  // container never gets a credential or a URL for it. Inert until the var
  // WARM_REPOS=1 is set. Create the bucket and its lifecycle backstop once:
  //   wrangler r2 bucket create buildd-cloud-runner-snapshots
  //   wrangler r2 bucket lifecycle add buildd-cloud-runner-snapshots warm-expiry warm/ --expire-days 14
  //   wrangler r2 bucket lifecycle add buildd-cloud-runner-snapshots park-expiry park/ --expire-days 2
  // Park bundles (RESUMABLE_RUNS=1) live under park/.
  // The refresher keeps two generations per workspace; the rule only
  // catches what it misses (a workspace that stopped running tasks).
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "buildd-cloud-runner-snapshots" }],

  // Plain vars. Secrets (wrangler secret put): DISPATCH_TOKEN, BUILDD_API_KEY,
  // AI_GATEWAY_TOKEN, and for local development only ANTHROPIC_DIRECT_API_KEY
  // (used only with the var ALLOW_DIRECT_ANTHROPIC=1; never on a deployed
  // Worker). Egress vars: AI_GATEWAY_ACCOUNT_ID, AI_GATEWAY_ID, or for an
  // Anthropic-compatible proxy (LiteLLM and similar) MODEL_PROXY_URL,
  // MODEL_PROXY_AUTH_HEADER plus the secret MODEL_PROXY_KEY. See README
  // "Egress credentials".
  // BUILDD_SERVER has no default on purpose: set it per deployment
  // (dashboard, `--var`, or an env block). The Worker refuses to dispatch
  // without it, because the runner would otherwise fall back to production.
  "vars": {
    // Must equal containers[0].instance_type above (run report; run-report.test.ts checks).
    "CONTAINER_INSTANCE_TYPE": "standard-1",
    // Must equal "name" above: every container reports it, so the fleet shows
    // this deployment as one elastic group (deploy.ts --name rewrites both).
    "RUNNER_GROUP": "buildd-cloud-runner",
    "CONTAINER_INACTIVITY_TIMEOUT_MS": "1800000",
    "CONTAINER_START_TIMEOUT_MS": "300000"
  }
}
