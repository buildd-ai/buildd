# Build context for images built from the repo root (apps/runner/Dockerfile.once,
# docker/worker/Dockerfile). Dockerfiles COPY named paths only; this keeps the
# context small and makes sure local secrets never reach the daemon at all.

# VCS, dependencies, build output
.git
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/*.tsbuildinfo

# Secrets and local config (see .gitignore)
**/.env
**/.env.*
!**/.env*.example
**/.mcp.json
**/.vercel
**/.claude
**/.agent
**/.buildd
**/.buildd-worktrees
**/.health-probe
**/.decision-data
**/.eval-data
**/*.pem
**/*.key

# Local artifacts
**/*.log
**/.DS_Store
**/*.pen
**/__pycache__
scripts/demo/out
.test-report.log

# Not needed by any image, and large
packages/core/drizzle
**/__tests__
**/*.test.ts
**/*.test.tsx
