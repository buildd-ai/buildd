# ===========================================
# BUILDD ENVIRONMENT VARIABLES
# ===========================================
# Copy to .env.local and fill in values
#
# VERCEL DASHBOARD - Add these environment variables:
#   - DATABASE_URL
#   - AUTH_SECRET
#   - GOOGLE_CLIENT_ID
#   - GOOGLE_CLIENT_SECRET
#   - CRON_SECRET (required for task schedules)
#   - ALLOWED_EMAILS (optional)
#   - PUSHER_* (optional, for realtime updates)
#   - NEXT_PUBLIC_PUSHER_* (optional, for realtime updates)
#   - DISPATCH_* (optional, Dispatch transport; see below)
#
# ===========================================

# ------------------------------------------
# Database (Required)
# ------------------------------------------
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ------------------------------------------
# NextAuth (Required for web)
# ------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Your production URL (Vercel will set this automatically)
AUTH_URL=http://localhost:3000

# ------------------------------------------
# Google OAuth (Required for web)
# ------------------------------------------
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google (dev)
#   - https://your-app.vercel.app/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email whitelist (comma-separated, leave empty to allow all)
ALLOWED_EMAILS=

# ------------------------------------------
# Pusher Channels (Optional - for realtime dashboard)
# ------------------------------------------
# Create at: https://dashboard.pusher.com
# Without Pusher, dashboard works but doesn't update in realtime
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ------------------------------------------
# Cron Jobs (Required for task schedules)
# ------------------------------------------
# Secret for authenticating the /api/cron/schedules endpoint
# This endpoint must be called every minute to trigger scheduled tasks
# Generate with: openssl rand -base64 32
# See docs/features/schedules.md for setup instructions
CRON_SECRET=

# ------------------------------------------
# Dispatch transport (Optional - Cloudflare-owned dispatch delivery)
# ------------------------------------------
# All three unset (the default): the transport is off and every workspace
# is delivered by the in-app drain. Even when set, only workspaces whose
# dispatch_transport is 'shadow' or 'dispatch' publish.
# Source of truth is Doppler `buildd` prd, synced to Vercel (one-way).
# Key rings are `keyId:secret[,keyId:secret]`; the first entry signs, every
# entry verifies, so two ids can be live during a rotation.
# Spec: docs/specs/task-dispatch-authority.md, "Dispatch transport (P0)".
# DISPATCH_URL=https://dispatch.example.com
# DISPATCH_PUBLISH_SECRET=k1:<openssl rand -hex 32>   # Buildd -> Dispatch
# DISPATCH_CALLBACK_SECRET=k1:<openssl rand -hex 32>  # Dispatch -> Buildd callbacks; unset = callbacks answer 503

# ------------------------------------------
# Claude API (Optional - for API-based agents)
# ------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------
# Storage - Cloudflare R2 (Agent only)
# ------------------------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=buildd-artifacts
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ------------------------------------------
# Agent Settings
# ------------------------------------------
DEFAULT_BRANCH_PREFIX=buildd/
WORKTREE_BASE_PATH=/tmp/buildd-worktrees
MAX_TURNS=100
MAX_COST_PER_WORKER=10.0

# ------------------------------------------
# Pushover notifications (owner ops alerts)
# ------------------------------------------
PUSHOVER_USER=
PUSHOVER_TOKEN_TASK=
PUSHOVER_TOKEN_ALERT=
# reportOps() in @buildd/core pushes swallowed warnings/errors to the "alerts"
# app. Off unless OPS_ALERTS_ENABLED is truthy. Warnings -> priority -2 (badge
# only), errors -> 0. OPS_THROTTLE_MS dedups same source+message (default 1h).
OPS_ALERTS_ENABLED=
OPS_THROTTLE_MS=

# ── OAuth budget pacing (seat-based accounts only) ──────────────────────────
# Learns this account's 5h session ceiling from past exhaustion episodes
# (oauth_budget_episodes) and throttles autonomous claiming as it approaches it.
# Inert until 3 episodes exist. Never applies to an explicit Start / single-task
# claim — a human start always wins.
#   unset | on  → enabled, conservative p25 capacity (default)
#   off         → kill switch, fully inert
#   0.1 .. 0.9  → use that quantile (higher = braver, throttles later)
# Read it back any time: curl -H "Authorization: Bearer $KEY" $HOST/api/accounts/me
OAUTH_BUDGET_PACING=on

# ------------------------------------------
# Billing - Stripe (Optional; values live in Doppler, never commit them)
# ------------------------------------------
# BILLING_ENFORCED off (the default) = every team is unlimited and the
# Settings -> Billing page and checkout/portal/seats routes do not exist.
# The webhook (POST /api/webhooks/stripe) records plan changes regardless.
# Events to send it: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
# Team base price covers 5 seats; the seat price is each seat above 5.
BILLING_ENFORCED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_SEAT=
