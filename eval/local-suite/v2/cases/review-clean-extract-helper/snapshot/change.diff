+  const sign = cents < 0 ? '-' : '';
+  if (ZERO_DECIMAL.has(currency)) return `${sign}${abs}`;
+  const frac = String(abs % 100).padStart(2, '0');
+  return `${sign}${Math.floor(abs / 100)}.${frac}`;
