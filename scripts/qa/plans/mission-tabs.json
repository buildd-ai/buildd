[
  {
    "route": "/app/missions/:id",
    "states": [
      {
        "key": "flow-from-menu",
        "steps": [
          { "action": "waitFor", "selector": "testid:mission-overflow-menu", "timeoutMs": 30000 },
          { "action": "click", "selector": "testid:mission-overflow-menu" },
          { "action": "click", "selector": "testid:mission-menu-flow" },
          { "action": "waitFor", "selector": "css:[data-testid^=\"flow-timeline\"]", "timeoutMs": 30000 },
          { "action": "assertLayout" }
        ]
      },
      {
        "key": "history-from-menu",
        "steps": [
          { "action": "waitFor", "selector": "testid:mission-overflow-menu", "timeoutMs": 30000 },
          { "action": "click", "selector": "testid:mission-overflow-menu" },
          { "action": "click", "selector": "testid:mission-menu-history" },
          { "action": "waitFor", "selector": "testid:mission-event-feed", "timeoutMs": 30000 },
          { "action": "assertLayout" }
        ]
      }
    ]
  }
]
