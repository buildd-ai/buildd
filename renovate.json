{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am every weekday"],
  "timezone": "America/New_York",
  "packageRules": [
    {
      "matchPackageNames": ["@anthropic-ai/{/,}**"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Anthropic AI SDK",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": ["@anthropic-ai/{/,}**"],
      "matchUpdateTypes": ["major"],
      "groupName": "Anthropic AI SDK (major)",
      "automerge": false
    },
    {
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"],
      "groupName": "drizzle"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "< 7.0.0",
      "description": "TypeScript 7 is a native-first rewrite that dropped lib/typescript.js; Next.js 16 can't detect it. Hold at 5.x until Next.js ships stable TS7 support."
    }
  ]
}
