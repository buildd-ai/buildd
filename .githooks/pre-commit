#!/usr/bin/env bash
# Spec hygiene gate. Fast (pure file I/O, sub-second) so it runs on every commit.
# Blocks the commit if any spec lacks lifecycle frontmatter, cites a dead
# code-surface path, or if docs/specs/INDEX.md is stale.
#
# Registered via `git config core.hooksPath .githooks` (done automatically by the
# package.json `prepare` script on `bun install`). Bypass in a pinch with
# `git commit --no-verify`.
set -euo pipefail

# apps/web/next-env.d.ts is generated: `next dev` and `next build` each rewrite
# it to a different import path, so a local build leaves a diff that is pure
# churn. Refuse to stage any change to it. Pinned by
# scripts/next-env-canonical.test.ts; a deliberate change (a Next upgrade)
# updates that test and commits with --no-verify.
if ! git diff --cached --quiet -- apps/web/next-env.d.ts; then
  echo "✖ apps/web/next-env.d.ts is staged. It is generated by next dev/build; don't commit it." >&2
  echo "  Unstage and restore it: git restore --staged --worktree apps/web/next-env.d.ts" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found, skipping spec lint" >&2
  exit 0
fi

# Never block a commit in a checkout that doesn't ship this linter (e.g. a
# different repo the runner cloned, or a partial checkout). No script → no gate.
if [ ! -f scripts/check-specs.ts ]; then
  exit 0
fi

if ! bun run scripts/check-specs.ts --check; then
  echo "" >&2
  echo "✖ spec lint failed. Fix the errors above, or run 'bun run specs:check'" >&2
  echo "  to regenerate docs/specs/INDEX.md, then re-stage and commit." >&2
  exit 1
fi

# Public-docs boundary gate. Pure file I/O, sub-second. Design/strategy prose
# belongs in the private knowledge-base repo; docs/design keeps stubs only.
if [ -f scripts/check-public-docs.ts ]; then
  if ! bun run scripts/check-public-docs.ts; then
    echo "" >&2
    echo "✖ public-docs check failed. Move the prose to knowledge-base buildd/design/" >&2
    echo "  and keep only the frontmatter stub here, then re-stage and commit." >&2
    exit 1
  fi
fi

# Migration journal ordering gate. Also fast (JSON parse only, no DB) — same
# sub-second budget as the spec check above. Drizzle's migrator applies
# journal entries by `when` high-water-mark, not idx order: a new migration
# authored with a `when` at or below an already-applied later entry's `when`
# is silently SKIPPED forever in prod (exit 0, looks green, DDL never runs).
# See packages/core/__tests__/migration-journal-ordering.test.ts for the
# incident history (0067, 0021/0022).
if [ -f packages/core/__tests__/migration-journal-ordering.test.ts ]; then
  if ! bun run migrations:lint >/dev/null 2>&1; then
    echo "" >&2
    echo "✖ migration journal lint failed: the newest migration's \"when\" in" >&2
    echo "  packages/core/drizzle/meta/_journal.json is not greater than every" >&2
    echo "  prior entry — Drizzle would silently skip it. Run 'bun run migrations:lint'" >&2
    echo "  for details, then bump \"when\" and re-stage." >&2
    exit 1
  fi
fi

# No Production Data gate, reproduced locally against the STAGED tree (--staged),
# so a UUID removed in this commit is not rejected and one added is caught here.
# The candidate commit message is checked by .githooks/commit-msg. CI scans
# committed HEAD. Never blocks on a missing base ref or missing python3.
if command -v python3 >/dev/null 2>&1 && [ -f scripts/check_no_prod_data.py ]; then
  if ! bash scripts/check-no-prod-data-local.sh --staged >/tmp/no-prod-data-precommit.log 2>&1; then
    echo "" >&2
    echo "✖ no-prod-data check failed (see .github/workflows/no-prod-data.yml)." >&2
    cat /tmp/no-prod-data-precommit.log >&2
    echo "" >&2
    echo "  This does not check PR title/body or the handle/private-repo secret" >&2
    echo "  — see scripts/check-no-prod-data-local.sh for what it can and can't" >&2
    echo "  see locally. Fix the line above, or add 'no-prod-data: allow <reason>'" >&2
    echo "  to the PR body once one exists." >&2
    exit 1
  fi
fi
