{
  "compilerOptions": {
    "target": "ES2022",
    // Consumers bundle these TypeScript sources directly; keep extensionless imports.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
